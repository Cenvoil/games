3+=_0x15f3ab(_0x72ff33._0x2410af,-_0x72ff33._0x37c7d3)+(_aboutTab==='gameplay'?'background:var(--primary)':'')+'\x22\x20onclick=\x22window._switchAboutTab(\x27gameplay\x27)\x22>🎣\x20玩法介绍</button>\x0a\x20\x20\x20\x20<button\x20class=\x22btn\x20btn-small\x22\x20style=\x22'+(_aboutTab===_0x15f3ab(_0x72ff33._0x3b74c4,_0x72ff33._0x277af3)?'background:var(--primary)':'')+_0x15f3ab(_0x72ff33._0xd1fb26,_0x72ff33._0x2760c4)+(_aboutTab==='systems'?'background:var(--primary)':'')+'\x22\x20onclick=\x22window._switchAboutTab(\x27systems\x27)\x22>🏆\x20系统养成</button>\x0a\x20\x20\x20\x20<button\x20class=\x22btn\x20btn-small\x22\x20style=\x22'+(_aboutTab===_0x15f3ab(_0x72ff33._0x37e550,_0x72ff33._0x4ab84b)?_0x15f3ab(0xfbc,0xc99):'')+'\x22\x20onclick=\x22window._switchAboutTab(\x27author\x27)\x22>👨‍💻\x20关于作者</button>\x0a\x20\x20</div>',_0x5e2143+=_0x15f3ab(0x244,_0x72ff33._0x217ec2);if(_aboutTab==='gameplay')_0x5e2143+='<h3\x20style=\x22color:var(--gold);margin-top:0\x22>🎣\x20玩法介绍</h3>\x0a\x20\x20\x20\x20<div\x20style=\x22font-size:0.85rem;line-height:1.8;color:var(--text-muted)\x22>\x0a\x20\x20\x20\x20\x20\x20<p>🖱️\x20<strong>抛竿蓄力</strong>：点击水面开始蓄力，力量条来回摆动，再次点击锁定力度。完美区域（≥88%）触发最远距离和缩短等待时间30%。良好(≥66%)也有加成。AD键可调整抛竿方向，左右各40°范围。风向和风力会影响抛竿距离，大风天气需预判偏移。</p>\x0a\x20\x20\x20\x20\x20\x20<p>🐟\x20<strong>等待咬钩</strong>：浮标入水后等待鱼上钩，时间3-10秒不等。期间可能触发假咬（1-2次浮标抖动并伴随提示音）。鱼咬钩时浮标剧烈下沉并发出警告音，需在反应窗口内（0.5-2秒）快速点击提竿！错过则鱼逃走。</p>\x0a\x20\x20\x20\x20\x20\x20<p>🎮\x20<strong>收线搏斗</strong>：按住<strong>空格键</strong>收线增加进度，同时张力上升。松开空格张力自然回落，鱼会趁机拉回进度。张力达100%断线，进度归零鱼逃脱。需要掌握收放节奏——高张力时松手缓冲，低张力时全力收线。装备的抗张力词条可显著降低张力增长速度。</p>\x0a\x20\x20\x20\x20\x20\x20<p>⚡\x20<strong>QTE应对系统</strong>：史诗及以上品质的鱼每5-10秒触发QTE。按提示快速按下对应按键（A-Z/0-9），史诗鱼还需鼠标点击靶心。成功获得20怒气+强力buff（3倍伤害持续2秒），还有概率触发眩晕（鱼几乎不增长张力）、闪避或鱼暴怒等特殊效果。</p>\x0a\x20\x20\x20\x20\x20\x20<p>🔥\x20<strong>怒气爆发</strong>：QTE成功积攒怒气，满100可手动按R键爆发/自动触发。怒气爆发期间大幅提升伤害，配合装备怒气词条可延长持续时间、提高伤害倍率。怒气是战胜高血量BOSS鱼的关键。</p>\x0a\x20\x20\x20\x20\x20\x20<p>🏃\x20<strong>鱼群逃离机制</strong>：连续在同一钓场钓鱼会增加逃离计数，超过阈值后咬钩率显著降低。放生鱼类减少20%当前压力，自然恢复极慢。可在设置中关闭此机制。</p>\x0a\x20\x20\x20\x20\x20\x20<p>🔄\x20<strong>连击系统</strong>：连续成功钓上鱼积累连击，提供金币加成(+3%/级)和稀有率加成。脱钩或放弃重置连击。高连击是快速积累财富和钓到稀有鱼的有效手段。</p>\x0a\x20\x20\x20\x20</div>';else{if(_aboutTab==='mechanics')_0x5e2143+='<h3\x20style=\x22color:var(--gold);margin-top:0\x22>⚙️\x20游戏机制详解</h3>\x0a\x20\x20\x20\x20<div\x20style=\x22font-size:0.85rem;line-height:1.8;color:var(--text-muted)\x22>\x0a\x20\x20\x20\x20\x20\x20<p><strong>张力系统</strong>：张力是搏斗的核心指标（0-100）。收线时张力上升速度受鱼的力量、天气、装备抗张力词条影响。高张力(>70%)下鱼挣扎概率大幅增加。张力达到100%即断线——鱼线断裂且消耗大量鱼线耐久。低张力(<20%)时鱼会趁机拉回大量进度。</p>\x0a\x20\x20\x20\x20\x20\x20<p><strong>鱼种类型</strong>：每种鱼有独特的行为原型——普通型(均衡)、敏捷型(反应窗口极短+高闪避率)、坦克型(超高血量+防御)、欺凌型(高攻击力+高张力增长)、BOSS型(全面强大，传说/神话专属)、挑战型(副本专属/特殊机制)。</p>\x0a\x20\x20\x20\x20\x20\x20<p><strong>鱼行为模式</strong>：挣扎(高张力触发，进度被拉回5-15%)、闪避(短暂无敌1秒，张力快速回落)、暴怒(攻击力和张力增长翻倍3秒)、眩晕(QTE成功后25%概率触发，3秒内张力增长×0.1，是输出的最佳窗口期)。</p>\x0a\x20\x20\x20\x20\x20\x20<p><strong>稀有度系统</strong>：普通(权重60)→罕见(29)→稀有(6)→史诗(3)→传说(1.5)→神话(0.5)。稀有度越高鱼战力越强但价值越高。鱼饵诱鱼力/天气/时段/等级/连击均可叠加提升稀有率。钻石商店诱饵可保底最低品质。</p>\x0a\x20\x20\x20\x20\x20\x20<p><strong>天气影响</strong>：8种天气循环——晴天/多云/小雨/暴雨/浓雾/大风/小雪/暴雪。恶劣天气大幅提升稀有鱼概率(暴雪+8%罕见/稀有/史诗/传说权重)，但增加收线难度(暴风+15%鱼力量)。风力和风向影响抛竿距离和偏移。每2-5分钟随机切换。</p>\x0a\x20\x20\x20\x20\x20\x20<p><strong>时段影响</strong>：7个时段——清晨(5-8时/+4%稀有率)、正午(11-14时/无加成)、下午(14-17时/+1%)、黄昏(17-19时/+6%/黄金时间)、傍晚(19-21时/+3%)、凌晨(21-2时/+4%)、夜间(2-5时/+2%)。每种鱼有时间偏好，在偏好时段更容易钓到。</p>\x0a\x20\x20\x20\x20\x20\x20<p><strong>抛竿品质</strong>：完美(≥88%力度/金色轨迹/最远距离+等待缩短30%)、良好(≥66%/绿色)、普通(≥33%/白色)、失误(<33%/红色/距离减半)。连续完美抛竿是对玩家节奏感的考验。</p>\x0a\x20\x20\x20\x20\x20\x20<p><strong>装备词条机制</strong>：共17种词条覆盖16个维度。品质越高词条越多(普通1-2条→神话4-5条)，档位1-5随机。属性刷新卡可重铸单件装备全部词条。词条之间相互独立，合理搭配是后期核心玩法。</p>\x0a\x20\x20\x20\x20</div>';else{if(_aboutTab===_0x15f3ab(_0x72ff33._0x2c62d4,0x6a2))_0x5e2143+='<h3\x20style=\x22color:var(--gold);margin-top:0\x22>🏆\x20系统养成</h3>\x0a\x20\x20\x20\x20<div\x20style=\x22font-size:0.85rem;line-height:1.8;color:var(--text-muted)\x22>\x0a\x20\x20\x20\x20\x20\x20<p><strong>📖\x20鱼类图鉴</strong>：收集200+种鱼(含挑战鱼种)。每个钓场有独立收集进度，达到25%/50%/75%/100%可领取金币、钻石、装备奖励。满图鉴奖励随机高品装备。每钓到新鱼种时自动提示。</p>\x0a\x20\x20\x20\x20\x20\x20<p><strong>⚙️\x20装备系统</strong>：三件套——鱼竿(攻击力/决定收线伤害)、鱼线(长度=抛竿距离+抗张力属性)、鱼饵(诱鱼力=等待缩短+稀有加成/可堆叠/咬钩消耗)。装备有品质和随机词条，可强化提升基础属性。词条机制：装备获得时档位随机固定(普通品质可出1-2档)，属性刷新卡可重铸。</p>\x0a\x20\x20\x20\x20\x20\x20<p><strong>🏠\x20水族馆</strong>：将钓到的鱼放入水族馆展示，鱼会持续产出金币(每5秒/鱼战力越高产出越多)。基础10槽，金币扩展+10槽，道具扩展+10槽(共30槽)。后台挂机/其他界面也持续产金币，左下角实时显示待领取金额。</p>\x0a\x20\x20\x20\x20\x20\x20<p><strong>🎁\x20宝箱抽奖</strong>：使用钥匙开启宝箱(普通~神话6档)。可获得装备(2-10%概率)、鱼饵×5-10个(12-24%)、钻石(0-30%)、经验(10%)、钥匙(1-10%)、金币(保底)。钥匙通过任务/成就/臭皮靴/钻石商店获得。</p>\x0a\x20\x20\x20\x20\x20\x20<p><strong>🏆\x20成就系统</strong>：99项成就覆盖14个分类——钓鱼数量(至100K)/图鉴(至200种)/稀有度/连击(至100)/水族馆(至50条)/钓场解锁/金币(至1亿)/等级(至100)/臭皮靴(至100只)/签到(至90天)/强化(至+60)/鱼重量/鱼线长度(至5000m)/渔具属性(至2000)/钻石累计/放生数量(至5000条)。</p>\x0a\x20\x20\x20\x20\x20\x20<p><strong>📊\x20等级系统</strong>：钓鱼获得经验升级(最高100级/Lv100约需千万经验)。每级提升稀有率0.025%。特定等级可领取礼包(金币/钻石/钥匙/水族馆道具)。装备经验加成词条可加速升级。</p>\x0a\x20\x20\x20\x20\x20\x20<p><strong>💎\x20钻石商店</strong>：购买传说钥匙(50💎/周限1)/神话钥匙(200💎)/水族馆道具(30💎/周限3)/金币(5💎换1000)/稀有诱饵(15💎)/史诗诱饵(40💎)/传说诱饵(100💎)/属性刷新卡(10💎/周限10)。周限购可在设置中关闭。</p>\x0a\x20\x20\x20\x20\x20\x20<p><strong>⚔️\x20挑战副本</strong>：纯技术考验模式！固定初始装备+1级属性，一次性钓上随机5条挑战鱼。每条鱼有独特机制(高速张力/超高血量/10键QTE+3靶心/隐藏进度条/高频QTE+挣扎/禁怒气/极暗界面/极短反应时间/慢速收线/全属性MAX)。任意脱钩即从头开始。通关后鱼种永久收录图鉴。</p>\x0a\x20\x20\x20\x20</div>';else _aboutTab==='author'&&(_0x5e2143+='<h3\x20style=\x22color:var(--gold);margin-top:0\x22>👨‍💻\x20关于作者</h3>\x0a\x20\x20\x20\x20<div\x20style=\x22font-size:0.85rem;line-height:1.7;color:var(--text-muted)\x22>\x0a\x20\x20\x20\x20\x20\x20<p>🎮\x20<strong>昵称</strong>：GaryGan</p>\x0a\x20\x20\x20\x20\x20\x20<p>📧\x20<strong>邮箱</strong>：24211157@bjtu.edu.cn</p>\x0a\x20\x20\x20\x20\x20\x20<p>🎨\x20独立游戏开发者，热爱钓鱼和游戏设计</p>\x0a\x20\x20\x20\x20</div>\x0a\x20\x20\x20\x20<div\x20style=\x22background:rgba(255,193,7,0.1);border:1px\x20solid\x20rgba(255,193,7,0.3);border-radius:8px;padding:12px;margin-top:16px\x22>\x0a\x20\x20\x20\x20\x20\x20<h3\x20style=\x22color:#ffc107;margin-top:0\x22>🤖\x20AI代码撰写声明</h3>\x0a\x20\x20\x20\x20\x20\x20<div\x20style=\x22font-size:0.85rem;line-height:1.7;color:var(--text-muted)\x22>\x0a\x20\x20\x20\x20\x20\x20\x20\x20<p>本游戏由\x20<strong>AI辅助编程</strong>\x20完成代码撰写，仅供<strong>学习和参考</strong>使用。</p>\x0a\x20\x20\x20\x20\x20\x20\x20\x20<p>游戏开发过程中投入了<strong>大量精力</strong>进行：</p>\x0a\x20\x20\x20\x20\x20\x20\x20\x20<p>📐\x20<strong>系统设计</strong>\x20·\x20🎮\x20<strong>游戏测试</strong>\x20·\x20⚖️\x20<strong>数值平衡</strong>\x20·\x20🎨\x20<strong>场景美化</strong></p>\x0a\x20\x20\x20\x20\x20\x20\x20\x20<p\x20style=\x22margin-top:8px;color:#ffc107\x22>⚠️\x20请勿轻易修改游戏核心系统，以免破坏游戏平衡和体验。</p>\x0a\x20\x20\x20\x20\x20\x20\x20\x20<p\x20style=\x22color:#4caf50\x22>✅\x20欢迎转载和分享本游戏！</p>\x0a\x20\x20\x20\x20\x20\x20</div>\x0a\x20\x20\x20\x20</div>');}}_0x5e2143+=_0x15f3ab(_0x72ff33._0x1c1ba4,0x814),_0x11b37c[_0x15f3ab(0x2b1,0x2aa)]=_0x5e2143;};window[_0x242670(0x60c,0x1c7)]=function(){const _0x5701e2={_0x5a1959:0x34,_0x2b3bf1:0xac3,_0x2fc77d:0x4fa,_0x223e59:0x1e0,_0x1fe844:0xb3b,_0xcd042c:0x1120,_0x2308c7:0x361,_0x45ec84:0x1fe,_0x4b2a41:0x3fb,_0x2e2b93:0x6bf,_0x4ebe32:0x982,_0x2e5e27:0x47a,_0x13fdd6:0xbba,_0x4e02a2:0x11e,_0x4042fc:0x3b0,_0x3ab0a4:0x13b},_0x2efda1={_0xdb374c:0x304},_0x5f4236={_0x579de6:0x69f},_0x15118c=new Date()['toDateString']();if(gameState['lastSignIn']===_0x15118c){showToast(_0x1fd5a0(-_0x5701e2._0x5a1959,0x310));return;}gameState[_0x1fd5a0(0x492,-0x26)]=_0x15118c;function _0x1fd5a0(_0x185cf0,_0x2a6893){return _0x242670(_0x185cf0- -_0x5f4236._0x579de6,_0x2a6893);}if(!gameState[_0x1fd5a0(0x186,-0x82)])gameState['signInStreak']=0x0;if(!gameState['signInTotal'])gameState[_0x1fd5a0(0x74e,_0x5701e2._0x2b3bf1)]=0x0;gameState['signInStreak']++,gameState['signInTotal']++;const _0x3ad384=Math[_0x1fd5a0(0xa1d,0x1047)](gameState['signInStreak'],0x7),_0x1fe058=[{'gold':0x32,'diamond':0x0,'keys':[],'msg':_0x1fd5a0(0x2c0,0x105)},{'gold':0x64,'diamond':0x0,'keys':['key_common'],'msg':_0x1fd5a0(0x711,0x9d1)},{'